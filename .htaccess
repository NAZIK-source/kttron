ErrorDocument 404 /404.html

# Служебные файлы репозитория (описание, настройки git) из браузера недоступны
<FilesMatch "^(README\.md|\.gitignore|\.gitattributes)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Программы для скачивания сайта целиком (HTTrack, Teleport, Offline Explorer, wget и т. п.) — доступ запрещён.
    # Поисковых роботов, браузеры и мессенджеры правило не трогает: в их User-Agent этих слов нет
    RewriteCond %{HTTP_USER_AGENT} (HTTrack|WebCopier|WebCopy|Cyotek|Teleport|Offline\ ?Explorer|Offline\ ?Navigator|WebZIP|SiteSnagger|SiteSucker|WebStripper|WebReaper|WebWhacker|Website\ ?Quester|Website\ ?Downloader|Website\ ?eXtractor|Web\ ?Downloader|Getleft|BlackWidow|NetZip|PageGrabber|WebSauger|Mass\ ?Downloader|Wget|WebLeacher|Xaldon|SuperBot|WebAuto) [NC]
    RewriteRule ^ - [F,L]

    # www.kttron.kz → kttron.kz (один адрес сайта для поисковиков)
    RewriteCond %{HTTP_HOST} ^www\.kttron\.kz$ [NC]
    RewriteRule ^ https://kttron.kz%{REQUEST_URI} [R=301,L]

    # Привычные адреса разделов → наши страницы
    RewriteRule ^contacts?/?$ /kontakty/ [R=301,L,NC]
    RewriteRule ^(about|about-us|company)/?$ /o-kompanii/ [R=301,L,NC]
    RewriteRule ^(catalog|katalog|products)/?$ /materials/ [R=301,L,NC]
    RewriteRule ^(docs|documents|dokumentaciya|sertifikaty|certificates)/?$ /dokumenty/ [R=301,L,NC]
</IfModule>

# Заголовки безопасности: сайт нельзя встроить в чужую страницу, при переходе на другие сайты
# не передаётся полный адрес, у страниц нет доступа к камере, микрофону, геолокации и оплате.
# Действуют на всё, что отдаёт Apache (страницы и кабинет); html/htm поэтому убраны из списка
# «Обрабатывать статические файлы с помощью nginx» в Plesk.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>
