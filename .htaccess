ErrorDocument 404 /404.html

# Служебные файлы репозитория (описание, настройки git) из браузера недоступны
<FilesMatch "^(README\.md|\.gitignore|\.gitattributes)$">
    Require all denied
</FilesMatch>

# www.kttron.kz → kttron.kz (один адрес сайта для поисковиков)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^www\.kttron\.kz$ [NC]
    RewriteRule ^ https://kttron.kz%{REQUEST_URI} [R=301,L]
</IfModule>

# Заголовки безопасности: сайт нельзя встроить в чужую страницу, при переходе на другие сайты
# не передаётся полный адрес, у страниц нет доступа к камере, микрофону, геолокации и оплате.
# Действуют на всё, что отдаёт Apache (страницы и кабинет); html/htm поэтому убраны из списка
# «Обрабатывать статические файлы с помощью nginx» в Plesk.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>
